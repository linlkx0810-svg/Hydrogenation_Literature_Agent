# Hydrogenation Literature Agent -- Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit the real .env file.
#
# All variables are optional; the pipeline works without them
# but rate limits and OA access will be reduced.

# OpenAlex polite pool -- use your real email for faster API access
OPENALEX_EMAIL=your@email.com

# Semantic Scholar API key -- optional, raises rate limits
# Register at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=your_key_here

# Unpaywall email -- required for Unpaywall OA PDF lookup in Stage 3
UNPAYWALL_EMAIL=your@email.com
